# 复制为仓库根的 `moondata.toml` 并改成本机路径。
#
# `moondata.toml` 写的是本机挂载点，不入库（见 .gitignore）；本文件入库，
# 只是为了让人知道有这么个东西、该写什么。
#
# 数据根的三层来源，优先级由高到低：
#   1. 命令行 --data-root
#   2. 环境变量 MOONDATA_DATA_ROOT
#   3. 本文件的 [data] root
# 相对路径各按自己那层的基准解析：命令行与环境变量按当前工作目录，本文件里写的
# 按本文件所在目录（这样仓库整个搬走也不失效）。`~` 一律展开。

[data]
root = "G:/Lunar_Optical_SAR_Registration_Dataset"
