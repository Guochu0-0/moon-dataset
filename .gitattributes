# data/ 下的 `.pts`、`.txt` 是 CRLF 文本，按字节原样存储。
data/** -text

# Dockerfile 的 RUN 里是 sh 脚本：行尾续行符 `\` 后面跟上 `\r` 会让构建以很难懂的
# 方式失败。core.autocrlf=true 会在 checkout 时把文本文件转成 CRLF，这里显式钉回 LF。
.sandcastle/Dockerfile text eol=lf

# _site/ 是入库的文档站构建产物（scripts/build_site.py），里面有 search-index.js 这类
# 单行几百 KB 的文件和大量图片，diff 只输出「Binary files differ」，改动看 docs/ 下的源。
_site/** -diff

# tests/test_site.py 按字节核对「入库的 _site/ == 生成器输出」，生成器写的是 LF。
# core.autocrlf=true 会在 checkout 时把文本转成 CRLF，测试就会误报过期，这里钉回 LF。
_site/**/*.html text eol=lf
_site/**/*.js text eol=lf
_site/**/*.css text eol=lf
